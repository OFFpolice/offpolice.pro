{
  "name": "OFFpolice.pro",
  "short_name": "OFFpolice.pro",
  "description": "OFFpolice official digital card and vlog",
  "start_url": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#09090b",
  "theme_color": "#09090b",
  "icons": [
    {
      "src": "./favicon.png",
      "sizes": "64x64",
      "type": "image/png"
    },
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "./apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ]
}
